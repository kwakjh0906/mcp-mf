# -----------------------------
# Python 기본 캐시/빌드 무시
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
build/
dist/
wheels/
pip-wheel-metadata/

# -----------------------------
# uv / 가상환경 관련
# -----------------------------
.venv/
.python-version

# -----------------------------
# VSCode 설정
# -----------------------------
.vscode/
.history/
*.code-workspace

# -----------------------------
# 운영체제 임시파일
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# 로그/임시 파일
# -----------------------------
*.log
*.tmp
*.bak

# -----------------------------
# Ollama 캐시 (필요 시 제외)
# -----------------------------
ollama/

# -----------------------------
# Chroma VectorDB (RAG DB)
# 생성물만 있고 다시 만들 수 있음 → 무조건 제외
# -----------------------------
vector_db/
chroma_db/
*.chroma/

# -----------------------------
# 데이터 원본/가공 파일
# '원본 CSV는 버전 관리할지 선택 가능'
# 아래는 가공 데이터만 무시
# -----------------------------
data/*.jsonl
data/*.parquet
data/output/
!data/manufacturing_terms.csv   # 원본 CSV는 keep

# -----------------------------
# MCP 관련 임시 pipe/socket (운영체제에 따라 생성)
# -----------------------------
*.sock
*.pid

# -----------------------------
# Python bytecode
# -----------------------------
*.pyc
